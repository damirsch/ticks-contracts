# RPC endpoints (public ones are rate limited; Alchemy is Robinhood's recommended provider)
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Launch (script/Launch.s.sol)
TOKEN_NAME=TICKS
TOKEN_SYMBOL=TICKS
TOKEN_SUPPLY=1000000000
# Receives the position NFT and every pool fee
OWNER=
# Pair asset: empty or 0x0 for native ETH, USDG is 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168 (6 decimals)
PAIR=0x0000000000000000000000000000000000000000
PAIR_DECIMALS=18
# Pool fee in hundredths of a basis point: 30000 = 3%, 20000 = 2%
POOL_FEE=30000
TICK_SPACING=200
START_MARKET_CAP_USD=75000
# USD price of one whole pair unit times 1e6 (ETH at $2,500 = 2500000000, USDG = 1000000)
PAIR_PRICE_USD_E6=2500000000
# Whole TICKS that go into the pool
POOL_TOKENS=100000000
# How many times above the launch price the pool still sells TICKS
RANGE_MULTIPLE=1000

# Fee collection (script/CollectFees.s.sol)
TOKEN=
POSITION_ID=
RECIPIENT=

# Transfers (tools/send-tokens.mjs). Never commit a real key
PRIVATE_KEY=
